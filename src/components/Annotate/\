function Annotate(props) {

    const [toAdd, setToAdd] = React.useState({});
    const [annotations, setAnnotations] = React.useState([]);
    const [annotation, setAnnotation] = React.useState({});

    const onSubmit = (annotation) => {
        const { geometry, data } = annotation

        this.setAnnotation({})
        this.setAnnotations(this.annotations.push({
                geometry: geometry,
                data: {
                    ...data,
                    id: Math.random()
                }
            })
        )
    }

    const onChange = (annotation) => {
        this.setAnnotation(annotation)
    }

    useEffect(() => {
        props.updateTitle("Annotate")
    // eslint-disable-next-line react-hooks/exhaustive-deps
    }, [])


    return(
        <div>
            <Annotation
              src="https://storage.googleapis.com/trayvisor/The%20Chef/2021-09-27-09-33-57PEZO8Ajpg"
              alt='Two pebbles anthropomorphized holding hands'
              annotations={annotations}
              value={this.annotation}
              onChange={this.onChange}
              onSubmit={this.onSubmit} 
        />
        </div>
    )
}

export default withRouter(Annotate);

import React, {useState, useMemo} from 'react';
import './App.css';
import Header from './components/Header/Header';
import LoginForm from './components/LoginForm/LoginForm';
import Products from './components/Products/Products';
import ProductList from './components/ProductList/ProductList';
import Menus from './components/Menus/Menus';
import Users from './components/Users/Users';
import Accueil from './components/Accueil/Accueil.js';
import Restaurants from './components/Restaurants/Restaurants.js';
import ResetPassword from './components/ResetPassword/ResetPassword';
import Annotate from './components/Annotate/Annotate';
import Tryout from './components/Tryout/Tryout';
import PrivateRoute from './utils/PrivateRoute';
import Box from '@mui/material/Box';
import {useContextObject} from './components/Context/Context';
import Toolbar from '@mui/material/Toolbar';


import AlertComponent from './components/AlertComponent/AlertComponent';
import { createTheme, ThemeProvider, useTheme } from '@mui/material/styles';
import { enUS, frFR } from '@mui/material/locale';

import { styled } from '@mui/material/styles';

import MuiAppBar from '@mui/material/AppBar';
import IconButton from '@mui/material/IconButton';
import MenuIcon from '@mui/icons-material/Menu';
import Typography from '@mui/material/Typography';
import Tooltip from '@mui/material/Tooltip';
import Avatar from '@mui/material/Avatar';
import Menu from '@mui/material/Menu';
import MenuItem from '@mui/material/MenuItem';

import Drawer from '@mui/material/Drawer';
import List from '@mui/material/List';
import Divider from '@mui/material/Divider';
import ListItem from '@mui/material/ListItem';
import ListItemIcon from '@mui/material/ListItemIcon';
import ListItemText from '@mui/material/ListItemText';
import InboxIcon from '@mui/icons-material/MoveToInbox';
import MailIcon from '@mui/icons-material/Mail';

import ChevronLeftIcon from '@mui/icons-material/ChevronLeft';
import ChevronRightIcon from '@mui/icons-material/ChevronRight';

import {
  BrowserRouter as Router,
  Switch,
  Route,
  Link
} from "react-router-dom";

const drawerWidth = 240;

const Main = styled('main', { shouldForwardProp: (prop) => prop !== 'displayMenu' })(
  ({ theme, displayMenu}) => ({
    flexGrow: 1,
    padding: theme.spacing(3),
    transition: theme.transitions.create('margin', {
      easing: theme.transitions.easing.sharp,
      duration: theme.transitions.duration.leavingScreen,
    }),
    marginLeft: `-${drawerWidth}px`,
    ...(displayMenu && {
      transition: theme.transitions.create('margin', {
        easing: theme.transitions.easing.easeOut,
        duration: theme.transitions.duration.enteringScreen,
      }),
      marginLeft: 0,
    }),
  }),
);

const AppBar = styled(MuiAppBar, {
  shouldForwardProp: (prop) => prop !== 'displayMenu',
})(({ theme, displayMenu }) => ({
  transition: theme.transitions.create(['margin', 'width'], {
    easing: theme.transitions.easing.sharp,
    duration: theme.transitions.duration.leavingScreen,
  }),
  ...(displayMenu && {
    width: `calc(100% - ${drawerWidth}px)`,
    marginLeft: `${drawerWidth}px`,
    transition: theme.transitions.create(['margin', 'width'], {
      easing: theme.transitions.easing.easeOut,
      duration: theme.transitions.duration.enteringScreen,
    }),
  }),
}));

const DrawerHeader = styled('div')(({ theme }) => ({
  display: 'flex',
  alignItems: 'center',
  padding: theme.spacing(0, 1),
  // necessary for content to be below app bar
  ...theme.mixins.toolbar,
  justifyContent: 'flex-end',
}));


function App() {

    //const {errorMessageHook, languageStateHook, displayMenuHook} = useContextObject();
  const {errorMessageHook, languageStateHook } = useContextObject();
  const [errorMessage, updateErrorMessage] = errorMessageHook;
  const [language, setLanguage] = languageStateHook;
    //const [displayMenu, setDisplayMenu] = displayMenuHook;
  const [displayMenu, setDisplayMenu] = useState(false);

  const [title, updateTitle] = useState(null);
  const [isAdmin, setIsAdmin] = useState(false);
  const [restaurant, setRestaurant] = useState(-1);
  const [me, setMe] = useState({})
  
  const muiLanguages = {
    'fr': frFR,
    'en': enUS
  }

  const theme = useTheme();

  const themeWithLocale = useMemo(
    () => createTheme(theme, muiLanguages[language]),
    [language, theme],
  );

   const handleDrawerOpen = () => {
      setDisplayMenu(true)
  };

  const handleDrawerClose = () => {
      setDisplayMenu(false)
  };

    //<Box component="main" sx={{ flexGrow: 1, p: 3 }}>
    //<Header/>

  return (
    <ThemeProvider theme={themeWithLocale}>
      <Router>
      <div className="App">
        <Box>

      <AppBar position="fixed" sx={{ background: "linear-gradient(90deg,#283373,#31ac6b)" }} open={displayMenu}>
        <Toolbar disableGutters>
          <Box sx={{ flexGrow: 1, display: { xs: 'flex' } }}>
            <IconButton
              size="large"
              onClick={handleDrawerOpen}
              color="inherit"
            >
              <MenuIcon />
            </IconButton>
          </Box>
          <Box sx={{ flexGrow: 1, display: { xs: 'none', md: 'flex' } }}>
          <Typography
            variant="h6"
            noWrap
            component="div"
            sx={{ mr: 2, display: { xs: 'none', md: 'flex' } }}
          >
          </Typography>
          </Box>
          <Box sx={{ flexGrow: 0 }}>
            <Tooltip title="LOL">
              <IconButton sx={{ p: 0, "padding-right": "10px" }}>
                <Avatar  src="/static/images/avatar/2.jpg" />
              </IconButton>
            </Tooltip>
            <Menu
              sx={{ mt: '45px' }}
              id="menu-appbar"
              anchorOrigin={{
                vertical: 'top',
                horizontal: 'right',
              }}
              keepMounted
              transformOrigin={{
                vertical: 'top',
                horizontal: 'right',
              }}
            >
                        </Menu>
          </Box>
  </Toolbar>
      </AppBar>

  <Drawer
        variant="permanent"
        sx={{
          width: drawerWidth,
          flexShrink: 0,
          [`& .MuiDrawer-paper`]: { width: drawerWidth, boxSizing: 'border-box', "z-index": 1 },
        }}
        open={false}
      >
        <DrawerHeader>
          <IconButton onClick={handleDrawerClose}>
            {theme.direction === 'ltr' ? <ChevronLeftIcon /> : <ChevronRightIcon />}
          </IconButton>
        </DrawerHeader>
        <Divider />
          <List>
                  <Link to="/products">
              <ListItem button key="Inscriptions">
                      <ListItemIcon>
                          <IconButton size="large" aria-label="account of current user" aria-controls="menu-appbar" aria-haspopup="true" color="inherit" >
                              <InboxIcon />
                          </IconButton>
                      </ListItemIcon>
                      <ListItemText primary="Inscriptions" sx={{color: "#283373"}} />
              </ListItem>
                  </Link>

                  <Link to="/menus">
              <ListItem button key="Ma Progression">
                      <ListItemIcon>
                          <IconButton size="large" aria-label="account of current user" aria-controls="menu-appbar" aria-haspopup="true" color="inherit" >
                              <InboxIcon />
                          </IconButton>
                      </ListItemIcon>
                      <ListItemText primary='Ma Progression'  sx={{color: "#283373"}} />
              </ListItem>
                  </Link>

                  <Link to="/annotate">
              <ListItem button key="Ma Seance">
                      <ListItemIcon>
                          <IconButton size="large" aria-label="account of current user" aria-controls="menu-appbar" aria-haspopup="true" color="inherit" >
                              <InboxIcon />
                          </IconButton>
                      </ListItemIcon>
                      <ListItemText primary='Ma Seance'  sx={{color: "#283373"}} />
              </ListItem>
                  </Link>


          </List>

          <Divider />

                  { isAdmin && 
                          <div>
          <List>
                  <Link to="/listing">
              <ListItem button key="productlist">
                      <ListItemIcon>
                          <IconButton size="large" aria-label="account of current user" aria-controls="menu-appbar" aria-haspopup="true" color="inherit" >
                              <InboxIcon />
                          </IconButton>
                      </ListItemIcon>
                      <ListItemText primary='Products-List'  sx={{color: "#283373"}} />
              </ListItem>
                  </Link>



          </List>

          <Divider />
          <List>
                  <Link to="/annotate">
              <ListItem button key="Annotations">
                      <ListItemIcon>
                          <IconButton size="large" aria-label="account of current user" aria-controls="menu-appbar" aria-haspopup="true" color="inherit" >
                              <InboxIcon />
                          </IconButton>
                      </ListItemIcon>
                      <ListItemText primary='Annotations'  sx={{color: "#283373"}} />
              </ListItem>
                  </Link>


                  <Link to="/users">
              <ListItem button key="users">
                      <ListItemIcon>
                          <IconButton size="large" aria-label="account of current user" aria-controls="menu-appbar" aria-haspopup="true" color="inherit" >
                              <InboxIcon />
                          </IconButton>
                      </ListItemIcon>
                      <ListItemText primary='Users'  sx={{color: "#283373"}} />
              </ListItem>
                  </Link>

                  <Link to="/restaurants">
              <ListItem button key="restaurants">
                      <ListItemIcon>
                          <IconButton size="large" aria-label="account of current user" aria-controls="menu-appbar" aria-haspopup="true" color="inherit" >
                              <InboxIcon />
                          </IconButton>
                      </ListItemIcon>
                      <ListItemText primary='Restaurants'  sx={{color: "#283373"}} />
              </ListItem>
                  </Link>


          </List>
          <Divider />

          <List>
                  <Link to="/reset-password">
              <ListItem button key="Reset Passowrd">
                      <ListItemIcon>
                          <IconButton size="large" aria-label="account of current user" aria-controls="menu-appbar" aria-haspopup="true" color="inherit" >
                              <InboxIcon />
                          </IconButton>
                      </ListItemIcon>
                      <ListItemText primary='Reset-Password'  sx={{color: "#283373"}} />
              </ListItem>
                  </Link>

          </List>

        </div>
        }

      </Drawer>



        <Main open={displayMenu}>
          <div className="container d-flex align-items-center flex-column">
            <Switch>
              <Route path="/login">
                <LoginForm/>
              </Route>
              <Route path="/accueil">
                <Accueil/>
              </Route>

              <PrivateRoute path="/listing">
                <ProductList />
              </PrivateRoute>
              <PrivateRoute path="/products">
                <Products />
              </PrivateRoute>
              <PrivateRoute path="/menus">
                <Menus />
              </PrivateRoute>
              <PrivateRoute path="/annotate">
                    <Annotate updateTitle={updateTitle}  isAdmin={isAdmin} me={me} restaurant={restaurant} setRestaurant={setRestaurant} />
              </PrivateRoute>
              <PrivateRoute path="/users">
                <Users />
              </PrivateRoute>
              <PrivateRoute path="/restaurants">
                <Restaurants />
              </PrivateRoute>
              <Route path="/reset-password">
                <ResetPassword />
              </Route>
              <PrivateRoute path="/tryout">
                <Tryout />
              </PrivateRoute>
            </Switch>
            <AlertComponent errorMessage={errorMessage} hideError={updateErrorMessage}/>
          </div>
        </Main>

        </Box>
      </div>
      </Router>
      </ThemeProvider>
  );
}

export default App;
